rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the authenticated user is one of Pullingal Soorath's designated admin accounts
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email.lower() == 'pullingalsoorath.dev@gmail.com' ||
         request.auth.token.email.lower() == 'pullingalsoorath@gmail.com');
    }

    // Check if authenticated user owns the document (by UID match)
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Contact form submissions from portfolio webpage
    match /messages/{messageId} {
      allow create: if true; // Public submission from contact form
      allow read, update, delete: if isAdmin();
    }

    // Official Resume & Portfolio Metadata
    match /resumes/{resumeId} {
      allow read: if true;
      allow write: if true;
    }

    match /resume_downloads/{downloadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /portfolio_metadata/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Rally 3D Global High Scores & Leaderboard
    match /rally3d_highscores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 15
                    && request.resource.data.score is number;
      allow update, delete: if request.auth != null; // Admin only
    }

    // User Profile Documents
    match /users/{userId} {
      allow read: if request.auth != null && (isOwner(userId) || isAdmin());
      allow create, update: if request.auth != null && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // 1-on-1 Realtime Chat Threads (where chatId == visitor's UID)
    match /chats/{chatId} {
      // Visitors can only read and update their own thread; Admins can access all threads
      allow read: if request.auth != null && (isOwner(chatId) || isAdmin());
      allow create, update: if request.auth != null && (isOwner(chatId) || isAdmin());
      allow delete: if isAdmin();

      // Messages Subcollection inside a chat thread
      match /messages/{messageId} {
        // Read: Visitor can read their own thread's messages; Admins can read any thread
        allow read: if request.auth != null && (isOwner(chatId) || isAdmin());
        
        // Create:
        // - Visitor can send messages with senderId == their UID and role == 'user'
        // - Admin can send messages with role == 'adminPS'
        allow create: if request.auth != null && (
          (isOwner(chatId) && request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == 'user') ||
          (isAdmin() && request.resource.data.senderRole == 'adminPS')
        );
        
        // Update (e.g., mark as read)
        allow update: if request.auth != null && (isOwner(chatId) || isAdmin());
        allow delete: if isAdmin();
      }
    }
  }
}
